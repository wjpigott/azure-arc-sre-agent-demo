ConfigurationData | where TimeGenerated > ago(30d) | where ConfigDataType =~ 'Software' | extend Product = case(SoftwareName has 'Adobe Acrobat', 'Adobe Acrobat', SoftwareName has '7-Zip' or SoftwareName has '7 Zip', '7-Zip', SoftwareName has 'Python', 'Python', SoftwareName has_any ('Java 8', 'JRE 8'), 'Java 8', SoftwareName has 'Google Chrome', 'Google Chrome', SoftwareName has 'Node.js', 'Node.js', 'Other') | where Product != 'Other' | summarize arg_max(TimeGenerated, Publisher, CurrentVersion, SoftwareType, SoftwareName) by Computer, Product | project Computer, Product, SoftwareName, Publisher, InstalledVersion = CurrentVersion, SoftwareType, InventoryTime = TimeGenerated | order by Product asc, Computer asc
