    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"\n  default-src 'none';\n  script-src 'self' 'nonce-{REPORT_NONCE}' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://esm.sh;\n  style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;\n  font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;\n  img-src 'self' data: blob: https:;\n  connect-src 'self';\n\">\n<title>Arc Fleet Operations</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\" integrity=\"sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC\" crossorigin=\"anonymous\"></script>\n<style nonce=\"{REPORT_NONCE}\">\n:root {\n  --blue: #0078d4; --blue-light: #e8f4fd; --green: #107c10; --green-bg: #dff6dd;\n  --yellow: #ca5010; --yellow-bg: #fff4ce; --red: #d13438; --red-bg: #fde7e9;\n  --gray-50: #fafafa; --gray-100: #f5f5f5; --gray-200: #e5e5e5; --gray-300: #d4d4d4;\n  --gray-500: #737373; --gray-700: #404040; --gray-900: #171717;\n}\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody { font-family: 'Inter', -apple-system, sans-serif; background: var(--gray-50); color: var(--gray-900); font-size: 13px; line-height: 1.5; padding: 20px; }\n.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 2px solid var(--blue); }\n.header h1 { font-size: 20px; font-weight: 700; color: var(--gray-900); }\n.header .sub { font-size: 11px; color: var(--gray-500); text-align: right; }\n.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(155px, 1fr)); gap: 12px; margin-bottom: 20px; }\n.card { background: #fff; border-radius: 8px; padding: 14px; border: 1px solid var(--gray-200); }\n.card .label { font-size: 11px; font-weight: 600; color: var(--gray-500); text-transform: uppercase; letter-spacing: 0.5px; }\n.card .value { font-size: 28px; font-weight: 700; margin-top: 4px; }\n.card .detail { font-size: 11px; color: var(--gray-500); margin-top: 2px; }\n.card.ok .value { color: var(--green); }\n.card.warn .value { color: var(--yellow); }\n.card.crit .value { color: var(--red); }\n.card.info .value { color: var(--blue); }\n.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }\n.section { background: #fff; border-radius: 8px; padding: 16px; border: 1px solid var(--gray-200); margin-bottom: 16px; }\n.section h2 { font-size: 14px; font-weight: 700; color: var(--gray-900); margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid var(--gray-200); display: flex; align-items: center; gap: 8px; }\n.section h2 .icon { width: 18px; height: 18px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; color: #fff; }\n.section h2 .icon.blue { background: var(--blue); }\n.section h2 .icon.red { background: var(--red); }\n.section h2 .icon.green { background: var(--green); }\n.section h2 .icon.yellow { background: var(--yellow); }\ntable { width: 100%; border-collapse: collapse; font-size: 12px; }\nth { text-align: left; font-weight: 600; color: var(--gray-500); font-size: 11px; text-transform: uppercase; letter-spacing: 0.3px; padding: 6px 8px; border-bottom: 2px solid var(--gray-200); }\ntd { padding: 6px 8px; border-bottom: 1px solid var(--gray-100); vertical-align: top; }\ntr:hover td { background: var(--gray-50); }\n.badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }\n.badge.green { background: var(--green-bg); color: var(--green); }\n.badge.yellow { background: var(--yellow-bg); color: var(--yellow); }\n.badge.red { background: var(--red-bg); color: var(--red); }\n.badge.blue { background: var(--blue-light); color: var(--blue); }\n.badge.gray { background: var(--gray-100); color: var(--gray-500); }\n.empty { color: var(--gray-500); font-style: italic; padding: 16px; text-align: center; }\n.error { color: var(--red); font-style: italic; padding: 12px; text-align: center; background: var(--red-bg); border-radius: 6px; font-size: 12px; }\n.chart-wrap { max-width: 220px; margin: 0 auto; }\n.loading { color: var(--gray-500); text-align: center; padding: 24px; }\n.loading::after { content: ''; display: inline-block; width: 16px; height: 16px; border: 2px solid var(--gray-300); border-top-color: var(--blue); border-radius: 50%; animation: spin .6s linear infinite; margin-left: 8px; vertical-align: middle; }\n@keyframes spin { to { transform: rotate(360deg); } }\n.priority-list { list-style: none; }\n.priority-list li { padding: 8px 10px; border-left: 3px solid var(--gray-300); margin-bottom: 6px; background: var(--gray-50); border-radius: 0 6px 6px 0; font-size: 12px; }\n.priority-list li.p1 { border-left-color: var(--red); background: var(--red-bg); }\n.priority-list li.p2 { border-left-color: var(--yellow); background: var(--yellow-bg); }\n.priority-list li.p3 { border-left-color: var(--blue); background: var(--blue-light); }\n@media (max-width: 900px) { .grid2 { grid-template-columns: 1fr; } }\n</style>\n</head>\n<body>\n\n<div class=\"header\">\n  <div>\n    <h1>Arc Fleet Operations</h1>\n    <div style=\"font-size:12px;color:var(--gray-500);\">Subscription __SUBSCRIPTION_ID__ &middot; Log Analytics Workspace</div>\n  </div>\n  <div class=\"sub\">\n    <div id=\"refresh-time\">Loading…</div>\n    <div>Read-only &middot; Auto-refresh on open</div>\n  </div>\n</div>\n\n<!-- Summary Cards -->\n<div class=\"cards\" id=\"summary-cards\">\n  <div class=\"card ok\"><div class=\"label\">Connected</div><div class=\"value\" id=\"c-connected\">–</div><div class=\"detail\" id=\"c-connected-d\">&nbsp;</div></div>\n  <div class=\"card crit\"><div class=\"label\">Unexpected Disconnected</div><div class=\"value\" id=\"c-disconnected\">–</div><div class=\"detail\" id=\"c-disconnected-d\">&nbsp;</div></div>\n  <div class=\"card info\"><div class=\"label\">Planned Offline</div><div class=\"value\" id=\"c-planned\">2</div><div class=\"detail\">LNX-SRV-01, WIN-SRV-19</div></div>\n  <div class=\"card warn\"><div class=\"label\">Stale Heartbeat</div><div class=\"value\" id=\"c-stale\">–</div><div class=\"detail\" id=\"c-stale-d\">&nbsp;</div></div>\n  <div class=\"card\" id=\"card-telem\"><div class=\"label\">Telemetry Gaps</div><div class=\"value\" id=\"c-telem\">–</div><div class=\"detail\" id=\"c-telem-d\">Machines with no Log Analytics data (24h)</div></div>\n  <div class=\"card warn\"><div class=\"label\">P1 Actions</div><div class=\"value\" id=\"c-p1\">–</div><div class=\"detail\">Critical issues requiring action</div></div>\n</div>\n\n<!-- Row: Fleet Inventory + Agent Versions -->\n<div class=\"grid2\">\n  <div class=\"section\">\n    <h2><span class=\"icon blue\">&#9632;</span> Fleet Inventory &amp; Heartbeat</h2>\n    <div id=\"fleet-table\"><div class=\"loading\">Loading fleet data</div></div>\n  </div>\n  <div class=\"section\">\n    <h2><span class=\"icon blue\">&#9650;</span> Arc Connected Machine Agent Versions</h2>\n    <div id=\"agent-chart-wrap\" style=\"display:flex;gap:16px;align-items:flex-start;\">\n      <div class=\"chart-wrap\"><canvas id=\"agent-chart\"></canvas></div>\n      <div id=\"agent-table\" style=\"flex:1;\"><div class=\"loading\">Loading</div></div>\n    </div>\n  </div>\n</div>\n\n<!-- Row: Resource Pressure + Patch Posture -->\n<div class=\"grid2\">\n  <div class=\"section\">\n    <h2><span class=\"icon yellow\">!</span> Resource Pressure</h2>\n    <div id=\"resource-table\"><div class=\"loading\">Loading disk &amp; memory data</div></div>\n  </div>\n  <div class=\"section\">\n    <h2><span class=\"icon red\">&#9888;</span> Operational Failures (24h)</h2>\n    <div id=\"events-table\"><div class=\"loading\">Loading event data</div></div>\n  </div>\n</div>\n\n<!-- Row: Change Tracking + Syslog -->\n<div class=\"grid2\">\n  <div class=\"section\">\n    <h2><span class=\"icon green\">&#916;</span> Recent Configuration Changes (24h)</h2>\n    <div id=\"changes-table\"><div class=\"loading\">Loading change tracking</div></div>\n  </div>\n  <div class=\"section\">\n    <h2><span class=\"icon yellow\">&#9888;</span> Linux Syslog Warnings+ (24h)</h2>\n    <div id=\"syslog-table\"><div class=\"loading\">Loading syslog data</div></div>\n  </div>\n</div>\n\n<!-- Priority Action List -->\n<div class=\"section\">\n  <h2><span class=\"icon red\">&#9733;</span> Priority Action List</h2>\n  <div id=\"priority-list\"><div class=\"loading\">Computing priorities</div></div>\n</div>\n\n<script nonce=\"{REPORT_NONCE}\">\n(async function() {\n  const SUB = '__SUBSCRIPTION_ID__';\n  const RG = '__RESOURCE_GROUP__';\n  const WS = '__WORKSPACE__';\n  const PLANNED_OFFLINE = ['LNX-SRV-01', 'WIN-SRV-19'];\n  const TOOL = 'system-mcp-monitor_monitor_workspace_log_query';\n\n  // Full fleet manifest — all 22 Arc machines from Azure Resource Graph\n  const FLEET = [\n    {name:'WIN-SRV-03', os:'Windows Server 2025 Standard', agent:'1.67', rg:'rg-arc-patching'},\n    {name:'WIN-SRV-14', os:'Windows Server 2025 Datacenter', agent:'1.67', rg:'rg-arc-patching'},\n    {name:'WIN-SRV-18', os:'Windows Server 2025 Standard', agent:'1.66', rg:'rg-arc-patching'},\n    {name:'WIN-SRV-15', os:'Windows Server 2019 Datacenter', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-01', os:'Windows Server 2025 Datacenter', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-02', os:'Windows Server 2025 Datacenter', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-04', os:'Windows Server 2025 Datacenter', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-16', os:'Windows Server 2025 Datacenter', agent:'1.66', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-17', os:'Windows Server 2022 Standard', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'LNX-SRV-02', os:'Ubuntu 22.04.5 LTS', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-05', os:'Windows Server 2025 Standard', agent:'1.66', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-13', os:'Windows Server 2022 Standard', agent:'1.53', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-06', os:'Windows Server 2022 Datacenter', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-07', os:'Windows Server 2012 R2 Standard', agent:'1.58', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-08', os:'Windows Server 2019 Standard', agent:'1.57', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-09', os:'Windows Server 2022 Datacenter', agent:'1.61', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-20', os:'Windows Server 2022 Datacenter', agent:'1.65', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-10', os:'Windows Server 2022 Standard', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-11', os:'Windows Server 2022 Standard', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-12', os:'Windows Server 2025 Datacenter', agent:'1.67', rg:'rg-arc-demo'},\n    {name:'LNX-SRV-01', os:'Ubuntu 22.04.5 LTS', agent:'1.66', rg:'rg-arc-demo'},\n    {name:'WIN-SRV-19', os:'Windows Server 2022 Datacenter', agent:'1.65', rg:'rg-arc-demo'},\n  ];\n\n  document.getElementById('refresh-time').textContent = 'Last refreshed: ' + new Date().toLocaleString();\n\n  // Host names: Heartbeat may report an FQDN (host.domain.local) while the manifest uses the short name.\n  function lrNorm(n) { return String(n == null ? '' : n).trim().toLowerCase().split('.')[0]; }\n  // Tool-result normalisation: plain object, JSON string, double-encoded JSON, MCP text envelope\n  // ({content:[{type:'text',text:'{...}'}]}), or {tables:[{columns,rows}]}. Returns {rows} or {error}; null if unrecognised.\n  function lrUnwrap(v) { let d = 0; while (typeof v === 'string' && d < 6) { const s = v.trim(); if (!/^[\\[{\"]/.test(s)) break; try { v = JSON.parse(s); } catch (e) { break; } d++; } return v; }\n  function lrRows(raw, depth) {\n    depth = depth || 0; const v = lrUnwrap(raw);\n    if (v == null || depth > 8) return null;\n    if (Array.isArray(v)) {\n      if (!v.length) return null;\n      if (v.every(x => x && typeof x === 'object' && !Array.isArray(x) && !('type' in x && 'text' in x))) return { rows: v };\n      for (const x of v) { const r = lrRows(x, depth + 1); if (r) return r; }\n      return null;\n    }\n    if (typeof v === 'object') {\n      const st = v.status !== undefined ? String(v.status) : null;\n      if (st && st !== '200') return { error: v.message || ('status ' + st) };\n      if (v.isError) return { error: String(v.message || v.error || 'tool error') };\n      if (Array.isArray(v.columns) && Array.isArray(v.rows)) {\n        const cols = v.columns.map(c => (c && (c.name || c.ColumnName)) || String(c));\n        return { rows: v.rows.map(r => Array.isArray(r) ? Object.fromEntries(cols.map((c, i) => [c, r[i]])) : r) };\n      }\n      if ('results' in v) { const r = lrUnwrap(v.results); if (Array.isArray(r) && !r.length) return { rows: [] }; const x = lrRows(r, depth + 1); if (x) return x; }\n      for (const k of ['structuredContent', 'content', 'text', 'result', 'data', 'tables', 'value', 'rows']) { if (k in v) { const x = lrRows(v[k], depth + 1); if (x) return x; } }\n    }\n    return null;\n  }\n\n  // Throws on any failure so each section shows an error instead of silently treating it as \"no data\".\n  async function query(table, kql, hours, limit) {\n    const raw = await window.sreagent.callTool(TOOL, {\n      'resource-group': RG, workspace: WS, subscription: SUB,\n      table: table, query: kql, hours: hours || 24, limit: limit || 200\n    });\n    const r = lrRows(raw);\n    if (!r) {\n      let s; try { s = typeof raw === 'string' ? raw : JSON.stringify(raw); } catch (e) { s = typeof raw; }\n      throw new Error(table + ' query: unrecognised tool response (' + String(s).slice(0, 120) + ')');\n    }\n    if (r.error) throw new Error(table + ' query error: ' + r.error);\n    return r.rows;\n  }\n\n  function el(tag, attrs, children) {\n    const e = document.createElement(tag);\n    if (attrs) Object.entries(attrs).forEach(([k,v]) => { if (k === 'className') e.className = v; else e.setAttribute(k,v); });\n    if (children) { if (typeof children === 'string') e.textContent = children; else children.forEach(c => { if (c) e.appendChild(c); }); }\n    return e;\n  }\n\n  function badge(text, cls) { return el('span', {className: 'badge ' + cls}, text); }\n\n  function makeTable(headers, rows) {\n    if (!rows || rows.length === 0) return el('div', {className:'empty'}, 'No data');\n    const t = el('table');\n    const thead = el('thead', null, [el('tr', null, headers.map(h => el('th', null, h)))]);\n    const tbody = el('tbody');\n    rows.forEach(r => {\n      const tr = el('tr');\n      r.forEach(c => {\n        const td = el('td');\n        if (typeof c === 'string') td.textContent = c;\n        else td.appendChild(c);\n        tr.appendChild(td);\n      });\n      tbody.appendChild(tr);\n    });\n    t.appendChild(thead); t.appendChild(tbody);\n    return t;\n  }\n\n  function setContent(id, node) {\n    const container = document.getElementById(id);\n    container.innerHTML = '';\n    if (typeof node === 'string') container.textContent = node;\n    else container.appendChild(node);\n  }\n\n  function setError(id, msg) {\n    const container = document.getElementById(id);\n    container.innerHTML = '';\n    const d = el('div', {className:'error'}, msg);\n    container.appendChild(d);\n  }\n\n  // Track findings for priority list\n  const actions = [];\n\n  // ========== 1. FLEET INVENTORY (all 22 machines from manifest + live heartbeat) ==========\n  try {\n    const hb = await query('Heartbeat',\n      'Heartbeat | summarize LastHeartbeat=max(TimeGenerated), OSType=any(OSType), Version=any(Version) by Computer | order by Computer asc',\n      24, 100);\n\n    // Build heartbeat lookup keyed by normalized short host name (FQDN-safe); keep the newest entry per host\n    const hbMap = {};\n    hb.forEach(m => {\n      const k = lrNorm(m.Computer); if (!k) return;\n      if (!hbMap[k] || new Date(m.LastHeartbeat) > new Date(hbMap[k].LastHeartbeat)) hbMap[k] = m;\n    });\n\n    const now = new Date();\n    let connected = 0, stale = 0, disconnected = 0, noTelemetry = 0;\n    const staleList = [], disconnectedList = [], noTelemList = [];\n\n    const rows = FLEET.map(f => {\n      const isPlanned = PLANNED_OFFLINE.some(p => lrNorm(f.name) === lrNorm(p));\n      const hbEntry = hbMap[lrNorm(f.name)];\n      let statusBadge, lastSeen;\n\n      if (isPlanned) {\n        statusBadge = badge('Planned Offline', 'gray');\n        lastSeen = '–';\n      } else if (!hbEntry) {\n        // In fleet manifest but no heartbeat — no AMA telemetry\n        noTelemetry++;\n        noTelemList.push(f.name);\n        statusBadge = badge('No Telemetry', 'red');\n        lastSeen = 'No AMA data';\n      } else {\n        const lb = new Date(hbEntry.LastHeartbeat);\n        const ageMin = (now - lb) / 60000;\n        if (ageMin <= 15) {\n          connected++;\n          statusBadge = badge('Connected', 'green');\n        } else if (ageMin <= 60) {\n          stale++;\n          staleList.push(f.name);\n          statusBadge = badge('Stale (' + Math.round(ageMin) + 'm)', 'yellow');\n        } else {\n          disconnected++;\n          disconnectedList.push(f.name);\n          statusBadge = badge('Disconnected', 'red');\n        }\n        lastSeen = ageMin < 60 ? Math.round(ageMin) + 'm ago' : Math.round(ageMin/60) + 'h ago';\n      }\n\n      // Show Arc agent version from manifest, AMA version from heartbeat if available\n      const arcVer = f.agent;\n      const amaVer = hbEntry ? hbEntry.Version : '–';\n      return [f.name, f.os, arcVer, amaVer, statusBadge, lastSeen];\n    });\n\n    document.getElementById('c-connected').textContent = connected;\n    document.getElementById('c-connected-d').textContent = connected + ' of ' + FLEET.length + ' total fleet';\n    document.getElementById('c-disconnected').textContent = disconnected;\n    document.getElementById('c-disconnected-d').textContent = disconnectedList.join(', ') || 'None';\n    document.getElementById('c-stale').textContent = stale;\n    document.getElementById('c-stale-d').textContent = staleList.join(', ') || 'None';\n    document.getElementById('c-telem').textContent = noTelemetry;\n    document.getElementById('c-telem-d').textContent = noTelemList.length > 0 ? noTelemList.join(', ') : 'All machines reporting';\n    document.getElementById('card-telem').className = noTelemetry > 0 ? 'card warn' : 'card ok';\n\n    if (disconnected > 0) actions.push({p:'p1', text: disconnected + ' machine(s) unexpectedly disconnected: ' + disconnectedList.join(', ')});\n    if (stale > 0) actions.push({p:'p2', text: stale + ' machine(s) with stale heartbeat (>15m): ' + staleList.join(', ')});\n    if (noTelemetry > 0) actions.push({p:'p2', text: noTelemetry + ' connected machine(s) have no AMA heartbeat — missing DCR: ' + noTelemList.join(', ')});\n\n    setContent('fleet-table', makeTable(['Machine','OS','Arc Agent','AMA','Status','Last Seen'], rows));\n\n    // Agent version distribution from manifest (Arc agent, not AMA)\n    const verCount = {};\n    FLEET.forEach(f => {\n      if (!PLANNED_OFFLINE.some(p => lrNorm(f.name) === lrNorm(p))) {\n        verCount[f.agent] = (verCount[f.agent]||0) + 1;\n      }\n    });\n    const versions = Object.entries(verCount).sort((a,b) => b[0].localeCompare(a[0]));\n    const latestVer = versions[0] ? versions[0][0] : 'Unknown';\n\n    const agentRows = versions.map(([ver, cnt]) => {\n      let drift;\n      if (ver === latestVer) drift = badge('Current', 'green');\n      else {\n        const verNum = parseFloat(ver);\n        const latNum = parseFloat(latestVer);\n        if (latNum - verNum <= 0.02) drift = badge('1-behind', 'blue');\n        else if (latNum - verNum <= 0.06) drift = badge('Drift', 'yellow');\n        else drift = badge('Unsupported', 'red');\n      }\n      return [ver, String(cnt), drift];\n    });\n    setContent('agent-table', makeTable(['Arc Agent','Count','Status'], agentRows));\n\n    // Chart\n    try {\n      const ctx = document.getElementById('agent-chart').getContext('2d');\n      const colors = ['#107c10','#0078d4','#ca5010','#d13438','#8764b8','#737373','#498205'];\n      new Chart(ctx, {\n        type: 'doughnut',\n        data: {\n          labels: versions.map(v => 'v' + v[0]),\n          datasets: [{data: versions.map(v => v[1]), backgroundColor: colors.slice(0, versions.length), borderWidth: 1}]\n        },\n        options: { responsive: true, plugins: { legend: { position: 'bottom', labels: {font:{size:10}} } } }\n      });\n    } catch(e) { /* chart is optional */ }\n\n  } catch(e) { setError('fleet-table', 'Failed to load fleet data: ' + e.message); }\n\n  // ========== 2. RESOURCE PRESSURE ==========\n  try {\n    const [diskData, memData] = await Promise.all([\n      query('Perf',\n        'Perf | where ObjectName == \"LogicalDisk\" and CounterName == \"% Free Space\" and InstanceName == \"C:\" | summarize AvgFree=round(avg(CounterValue),1), MinFree=round(min(CounterValue),1), Samples=count() by Computer | order by AvgFree asc',\n        24, 100),\n      query('Perf',\n        'Perf | where ObjectName == \"Memory\" and CounterName == \"Available MBytes\" | summarize AvgMB=round(avg(CounterValue),0), MinMB=round(min(CounterValue),0) by Computer | order by AvgMB asc',\n        24, 100)\n    ]);\n\n    const memMap = {};\n    memData.forEach(m => { memMap[m.Computer] = m; });\n\n    const rows = [];\n    diskData.forEach(d => {\n      const avg = parseFloat(d.AvgFree);\n      const min = parseFloat(d.MinFree);\n      const mem = memMap[d.Computer];\n      let diskBadge;\n      if (avg < 15) { diskBadge = badge(d.AvgFree + '%', 'red'); actions.push({p:'p1', text: d.Computer + ': OS disk at ' + d.AvgFree + '% free (min ' + d.MinFree + '%)'}); }\n      else if (avg < 25) diskBadge = badge(d.AvgFree + '%', 'yellow');\n      else diskBadge = badge(d.AvgFree + '%', 'green');\n\n      let memBadge = badge('N/A', 'gray');\n      if (mem) {\n        const mAvg = parseFloat(mem.AvgMB);\n        if (mAvg < 512) { memBadge = badge(mem.AvgMB + ' MB', 'red'); }\n        else if (mAvg < 1024) { memBadge = badge(mem.AvgMB + ' MB', 'yellow'); }\n        else memBadge = badge(mem.AvgMB + ' MB', 'green');\n      }\n      rows.push([d.Computer, diskBadge, d.MinFree + '%', memBadge, mem ? mem.MinMB + ' MB' : '–', d.Samples]);\n    });\n\n    // Add machines that have memory but no disk\n    memData.forEach(m => {\n      if (!diskData.find(d => d.Computer === m.Computer)) {\n        const mAvg = parseFloat(m.AvgMB);\n        let memBadge;\n        if (mAvg < 512) memBadge = badge(m.AvgMB + ' MB', 'red');\n        else if (mAvg < 1024) memBadge = badge(m.AvgMB + ' MB', 'yellow');\n        else memBadge = badge(m.AvgMB + ' MB', 'green');\n        rows.push([m.Computer, badge('N/A', 'gray'), '–', memBadge, m.MinMB + ' MB', '–']);\n      }\n    });\n\n    setContent('resource-table', makeTable(['Machine','Disk Free Avg','Disk Min','Memory Avg','Mem Min','Samples'], rows));\n\n  } catch(e) { setError('resource-table', 'Failed to load resource data: ' + e.message); }\n\n  // ========== 3. OPERATIONAL FAILURES (Windows Events) ==========\n  try {\n    const events = await query('Event',\n      'Event | where EventLevelName in (\"Error\",\"Critical\") | summarize Count=count(), LastSeen=max(TimeGenerated) by Computer, EventLog, Source, EventID, EventLevelName | order by Count desc',\n      24, 30);\n\n    const rows = events.map(e => {\n      const lvl = e.EventLevelName === 'Critical' ? badge('Critical', 'red') : badge('Error', 'yellow');\n      return [e.Computer, e.EventLog, e.Source, e.EventID, lvl, e.Count, e.LastSeen ? new Date(e.LastSeen).toLocaleTimeString() : '–'];\n    });\n\n    if (events.length > 0) {\n      // Group by machine for action items\n      const machineErrors = {};\n      events.forEach(e => {\n        if (!machineErrors[e.Computer]) machineErrors[e.Computer] = 0;\n        machineErrors[e.Computer] += parseInt(e.Count);\n      });\n      const topMachines = Object.entries(machineErrors).sort((a,b) => b[1]-a[1]).slice(0,3);\n      topMachines.forEach(([m, c]) => {\n        actions.push({p:'p2', text: m + ': ' + c + ' error/critical events in last 24h — investigate top sources'});\n      });\n    }\n    setContent('events-table', makeTable(['Machine','Log','Source','EventID','Level','Count','Last Seen'], rows));\n\n  } catch(e) { setError('events-table', 'Failed to load event data: ' + e.message); }\n\n  // ========== 4. LINUX SYSLOG ==========\n  try {\n    const syslog = await query('Syslog',\n      'Syslog | where SeverityLevel in (\"warning\",\"err\",\"crit\",\"alert\",\"emerg\") | summarize Count=count(), LastSeen=max(TimeGenerated) by Computer, Facility, SeverityLevel, ProcessName | order by Count desc',\n      24, 30);\n\n    const rows = syslog.map(s => {\n      let cls = 'yellow';\n      if (s.SeverityLevel === 'crit' || s.SeverityLevel === 'alert' || s.SeverityLevel === 'emerg') cls = 'red';\n      return [s.Computer, s.Facility, s.ProcessName || '–', badge(s.SeverityLevel, cls), s.Count];\n    });\n    setContent('syslog-table', makeTable(['Machine','Facility','Process','Severity','Count'], rows));\n\n  } catch(e) { setError('syslog-table', 'Failed to load syslog data: ' + e.message); }\n\n  // ========== 5. CHANGE TRACKING ==========\n  try {\n    const changes = await query('ConfigurationChange',\n      'ConfigurationChange | summarize Changes=count(), LastChange=max(TimeGenerated) by Computer, ConfigChangeType | order by Changes desc',\n      24, 40);\n\n    const rows = changes.map(c => {\n      let typeBadge;\n      const ct = c.ConfigChangeType || 'Other';\n      if (ct === 'WindowsServices' || ct === 'Daemons') typeBadge = badge(ct, 'blue');\n      else if (ct === 'Software') typeBadge = badge(ct, 'yellow');\n      else if (ct === 'Files') typeBadge = badge(ct, 'green');\n      else typeBadge = badge(ct, 'gray');\n      return [c.Computer, typeBadge, c.Changes, c.LastChange ? new Date(c.LastChange).toLocaleTimeString() : '–'];\n    });\n    setContent('changes-table', makeTable(['Machine','Change Type','Count','Last Change'], rows));\n\n  } catch(e) { setError('changes-table', 'Failed to load change tracking: ' + e.message); }\n\n  // ========== 6. PRIORITY ACTION LIST ==========\n  // Add standing actions based on known fleet state\n  actions.push({p:'p1', text: 'WIN-SRV-07: Windows Server 2012 R2 ESU Year 3 expires Oct 13, 2026 — migrate or document risk acceptance'});\n  actions.push({p:'p2', text: 'Verify patch assessment coverage — 9+ machines may lack recent Azure Update Manager assessment data'});\n  actions.push({p:'p3', text: '6 connected machines lack AMA DCR assignments to Log Analytics workspace — create Data Collection Rules'});\n\n  // Sort: p1 first, then p2, then p3\n  const order = {p1: 0, p2: 1, p3: 2};\n  actions.sort((a,b) => (order[a.p]||9) - (order[b.p]||9));\n\n  document.getElementById('c-p1').textContent = actions.filter(a => a.p === 'p1').length;\n\n  const ul = el('ul', {className: 'priority-list'});\n  actions.forEach(a => {\n    const li = el('li', {className: a.p});\n    const pLabel = a.p === 'p1' ? 'P1 CRITICAL' : a.p === 'p2' ? 'P2 IMPORTANT' : 'P3 PLAN';\n    const span = el('strong', null, pLabel + ': ');\n    li.appendChild(span);\n    const txt = document.createTextNode(a.text);\n    li.appendChild(txt);\n    ul.appendChild(li);\n  });\n\n  if (actions.length === 0) {\n    setContent('priority-list', el('div', {className:'empty'}, 'No priority actions identified'));\n  } else {\n    setContent('priority-list', ul);\n  }\n\n})();\n</script>\n</body>\n</html>\n",
